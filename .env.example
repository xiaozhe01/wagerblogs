# Copy to .env.local and fill in. Values here are placeholders, never secrets.

# Payload
PAYLOAD_SECRET=

# Supabase Postgres, session-mode pooler (port 5432, not the 6543 transaction
# pooler — Drizzle prepared statements break under transaction pooling).
DATABASE_URL=

# S3-compatible media storage
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Origin the admin panel builds Live Preview URLs against. Optional in local
# development, where it falls back to http://localhost:3000.
#
# Leave this line commented out unless you have a real value. Copying it in
# blank sets the variable to an empty string, which is not the same as unset.
#
# Deliberately separate from `siteUrl` in lib/schema.tsx, which is pinned to the
# production domain because the sitemap, llms.txt and JSON-LD must emit absolute
# production URLs regardless of where they are generated.
# NEXT_PUBLIC_SERVER_URL=https://wagerblogs.com
